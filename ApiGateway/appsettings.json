{
  "Jwt": {
    "Key": "ConnectSphere_SuperSecret_JWT_Key_2026_MustBeAtLeast32Characters!",
    "Issuer": "ConnectSphere.Auth",
    "Audience": "ConnectSphere.Client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "google-auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/google/{**catch-all}"
        }
      },
      "auth-google-verify": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/google/verify"
        }
      },
      "auth-register": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/register"
        }
      },
      "auth-login": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/login"
        }
      },
      "auth-validate-token": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/validate-token"
        }
      },
      "auth-refresh-token": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/refresh-token"
        }
      },
      "auth-get-by-username": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/by-username/{userName}"
        }
      },
      "auth-search-users": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/search"
        }
      },
      "auth-all": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "post-public-list": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/public"
        }
      },
      "post-public-hashtag": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/hashtag/{tag}"
        }
      },
      "post-public-search": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/search"
        }
      },
      "post-public-trending": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/trending"
        }
      },
      "post-all": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "comment-by-post": {
        "ClusterId": "comment-cluster",
        "Match": {
          "Path": "/api/comments/byPost/{postId}"
        }
      },
      "comment-all": {
        "ClusterId": "comment-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "like-count": {
        "ClusterId": "like-cluster",
        "Match": {
          "Path": "/api/likes/count"
        }
      },
      "like-by-target": {
        "ClusterId": "like-cluster",
        "Match": {
          "Path": "/api/likes/byTarget/{targetId}"
        }
      },
      "like-likers": {
        "ClusterId": "like-cluster",
        "Match": {
          "Path": "/api/likes/likers/{postId}"
        }
      },
      "like-all": {
        "ClusterId": "like-cluster",
        "Match": {
          "Path": "/api/likes/{**catch-all}"
        }
      },
      "follow-all": {
        "ClusterId": "follow-cluster",
        "Match": {
          "Path": "/api/follows/{**catch-all}"
        }
      },
      "notification-all": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "feed-trending": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/trending"
        }
      },
      "feed-all": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/{**catch-all}"
        }
      },
      "swagger-auth": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/swagger-auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-post": {
        "ClusterId": "post-cluster",
        "Match": { "Path": "/swagger-post/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-like": {
        "ClusterId": "like-cluster",
        "Match": { "Path": "/swagger-like/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-comment": {
        "ClusterId": "comment-cluster",
        "Match": { "Path": "/swagger-comment/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-follow": {
        "ClusterId": "follow-cluster",
        "Match": { "Path": "/swagger-follow/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-notification": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/swagger-notification/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "swagger-feed": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/swagger-feed/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-primary": {
            "Address": "http://localhost:5050"
          }
        }
      },
      "post-cluster": {
        "Destinations": {
          "post-primary": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "like-cluster": {
        "Destinations": {
          "like-primary": {
            "Address": "http://localhost:5200"
          }
        }
      },
      "comment-cluster": {
        "Destinations": {
          "comment-primary": {
            "Address": "http://localhost:5300"
          }
        }
      },
      "follow-cluster": {
        "Destinations": {
          "follow-primary": {
            "Address": "http://localhost:5400"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-primary": {
            "Address": "http://localhost:5500"
          }
        }
      },
      "feed-cluster": {
        "Destinations": {
          "feed-primary": {
            "Address": "http://localhost:5600"
          }
        }
      }
    }
  }
