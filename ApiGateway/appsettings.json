    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "auth-primary": {
            "Address": "http://localhost:5050/"
          }
        }
      },
      "post-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "post-primary": {
            "Address": "http://localhost:5100/"
