          "Path": "/api/follows/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/follows"
          }
        ]
      },
      "notification-swagger": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/notifications"
          }
        ]
      },
      "feed-swagger": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/feed"
          }
        ]
      },
      "auth-register": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/register"
        }
      },
      "auth-login": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/login"
        }
      },
      "auth-validate-token": {
        "ClusterId": "auth-cluster",
        "Match": {
