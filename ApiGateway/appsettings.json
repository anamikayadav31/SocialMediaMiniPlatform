{
  "Jwt": {
    "Key": "ConnectSphere_SuperSecret_JWT_Key_2026_MustBeAtLeast32Characters!",
    "Issuer": "ConnectSphere.Auth",
    "Audience": "ConnectSphere.Client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "google-auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/google/{**catch-all}"
        }
      },
      "auth-google-verify": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/google/verify"
        }
      },
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/users"
          }
        ]
      },
      "post-swagger": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/posts"
          }
        ]
      },
      "like-swagger": {
        "ClusterId": "like-cluster",
        "Match": {
          "Path": "/api/likes/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/likes"
          }
        ]
      },
      "comment-swagger": {
        "ClusterId": "comment-cluster",
        "Match": {
          "Path": "/api/comments/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/comments"
